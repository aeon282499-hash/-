  d=pd.concat([am.rename('am'),pm.rename('pm')],axis=1).dropna(); print(f'\n  同日相関 AM15分 vs PM5分: r={d.am.corr(d.pm):+.3f}  PM5分SL$10到達 {int((T["PM 5分"].gross==-SL).sum())}回/{len(pm)}  AM15分 {int((T["AM 15分(現行)"].gross==-SL).sum())}回')
